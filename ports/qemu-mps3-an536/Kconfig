config RT_SCOPE_QEMU_MPS3_AN536_PORT
    bool
    default y

config RT_SCOPE_DEVICE_ID
    hex "Microscope Scope device ID"
    default 0x0000A536

config RT_SCOPE_EMERGENCY_STACK_SIZE
    int "Microscope Scope emergency stack size"
    range 1024 2048
    default 1024
    help
        Stack and all Probe state must fit the BSP's 4 KiB reserved Scope
        workspace. The linker rejects configurations which exceed it.

config RT_SCOPE_READ_REGION_START
    hex
    default 0x20000000

config RT_SCOPE_READ_REGION_SIZE
    hex
    default 0x00100000

config RT_SCOPE_SECONDARY_READ_REGION_START
    hex
    default 0x10000000

config RT_SCOPE_SECONDARY_READ_REGION_SIZE
    hex
    default 0x00080000

config RT_SCOPE_TERTIARY_READ_REGION_START
    hex
    default 0x08000000

config RT_SCOPE_TERTIARY_READ_REGION_SIZE
    hex
    default 0x00800000

config RT_SCOPE_USING_FAULT_INJECTION
    bool "Enable unsafe Scope fault injection command"
    depends on RT_USING_MSH
    default n
    help
        Export the msfault command for diagnostic verification. This command
        intentionally triggers a processor exception and must remain disabled
        in production configurations.

if RT_SCOPE_USING_FAULT_INJECTION

config RT_SCOPE_FAULT_INJECTION_ADDRESS
    hex "Fault injection address"
    default 0xFFFFFFF0
    help
        Address read by msfault data-abort. It must be unmapped on the target.

endif
