menuconfig PKG_USING_MS_PROBE
    bool "ms-probe: Microscope embedded diagnostic components"
    select RT_USING_MICROSCOPE
    default n
    help
        GPL-2.0 / commercial dual-licensed development diagnostics.
        Scope, backtrace and coredump are configured below.
        Disable this package and Fault injection in production builds.

if PKG_USING_MS_PROBE

config PKG_MS_PROBE_PATH
    string
    default "/packages/tools/ms-probe"

choice
    prompt "Version"
    default PKG_USING_MS_PROBE_LATEST_VERSION

config PKG_USING_MS_PROBE_LATEST_VERSION
    bool "latest"

endchoice

config PKG_MS_PROBE_VER
    string
    default "latest" if PKG_USING_MS_PROBE_LATEST_VERSION

endif

rsource "Kconfig.options"
